# ==============================================================================
# Mandala Art Store - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in your local environment.
# 2. Never commit actual secret values or '.env' files to Git.
# 3. Only variables prefixed with 'VITE_' are exposed to client-side code.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Server-Only - NEVER expose to client)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Database (Planned for future persistence phase - PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mandala_store

# Payment Gateway (Planned - Server secrets must NEVER be accessible to frontend)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key_never_expose_to_frontend

# Authentication (Planned - Server secret for signing session/JWT tokens)
JWT_SECRET=development_placeholder_jwt_secret_min_32_characters

# ------------------------------------------------------------------------------
# Frontend Configuration (Safe for Client exposure - prefixed with VITE_)
# ------------------------------------------------------------------------------
# Base URL for backend API requests from the frontend client
VITE_API_URL=http://localhost:5000/api

# Public Payment Key (Only public key id, never secret)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
